def alternar_tela():

    global tela, fullscreen, tamanho_tela

    fullscreen = not fullscreen

    if fullscreen:
        info = pygame.display.Info()
        tamanho_tela = (info.current_w, info.current_h)

        tela = pygame.display.set_mode(
            tamanho_tela,
            pygame.FULLSCREEN
        )

    else:
        tamanho_tela = (W, H)
        tela = pygame.display.set_mode((W, H))


def apresentar():

    imagem = pygame.transform.smoothscale(
        canvas,
        tela.get_size()
    )

    tela.blit(imagem, (0, 0))
    pygame.display.flip()


def pos_mouse(pos):

    largura, altura = tela.get_size()

    return (
        int(pos[0] * W / largura),
        int(pos[1] * H / altura)
    )


# ==========================================
# DESENHO
# ==========================================

def texto(msg, fonte_usada, cor, x, y):

    imagem = fonte_usada.render(msg, True, cor)
    ret = imagem.get_rect(center=(x, y))
    canvas.blit(imagem, ret)


def botao(msg, x, y, largura, altura, mouse, cor):

    ret = pygame.Rect(x, y, largura, altura)

    cor_final = cor

    if ret.collidepoint(mouse):
        cor_final = tuple(min(c + 35, 255) for c in cor)

    pygame.draw.rect(
        canvas, cor_final, ret, border_radius=13
    )

    texto(
        msg, fonte, BRANCO,
        x + largura // 2,
        y + altura // 2
    )

    return ret


