        if tipo == "dragao" and i > 0:
            pygame.draw.polygon(
                superficie,
                (255, 150, 30),
                [
                    (px, py - 7),
                    (px - 5, py - 17),
                    (px + 5, py - 8)
                ]
            )

        # Brilhos do unicórnio
        if tipo == "unicornio":
            pygame.draw.circle(
                superficie,
                (255, 255, 255),
                (px, py - 4),
                3
            )

