# ==========================================
# JOGO
# ==========================================

def jogar():

    global moedas

    config = dificuldades[dificuldade]

    largura = config["largura"]
    altura = config["altura"]
    velocidade = config["velocidade"]

    colunas = largura // TAM
    linhas = altura // TAM

    cx = colunas // 2
    cy = linhas // 2

    cobrinha = [
        (cx, cy),
        (cx - 1, cy),
        (cx - 2, cy)
    ]

    direcao = (1, 0)
    proxima = direcao

    comida = criar_maca(cobrinha, colunas, linhas)

    pontos = 0
    movimento = pygame.time.get_ticks()
    intervalo = 1000 / velocidade

    executando = True

    while executando:

        agora = pygame.time.get_ticks()

        for evento in pygame.event.get():

            if evento.type == pygame.QUIT:
                salvar()
                pygame.quit()
                sys.exit()

            if evento.type == pygame.KEYDOWN:

                if evento.key == pygame.K_F11:
                    alternar_tela()

                elif evento.key == pygame.K_ESCAPE:
                    executando = False

                elif evento.key in (pygame.K_UP, pygame.K_w):
                    if direcao != (0, 1):
                        proxima = (0, -1)

                elif evento.key in (pygame.K_DOWN, pygame.K_s):
                    if direcao != (0, -1):
                        proxima = (0, 1)

                elif evento.key in (pygame.K_LEFT, pygame.K_a):
                    if direcao != (1, 0):
                        proxima = (-1, 0)

                elif evento.key in (pygame.K_RIGHT, pygame.K_d):
                    if direcao != (-1, 0):
                        proxima = (1, 0)

        if not executando:
            break

        if agora - movimento >= intervalo:

            movimento = agora
            direcao = proxima

            cabeca = (
                cobrinha[0][0] + direcao[0],
                cobrinha[0][1] + direcao[1]
            )

            comeu = cabeca == comida

            # Verificar colisão antes de mover
            if (
                cabeca[0] < 0 or cabeca[0] >= colunas
                or cabeca[1] < 0 or cabeca[1] >= linhas
                or cabeca in (cobrinha[:-1] if not comeu else cobrinha)
            ):
                break

            cobrinha.insert(0, cabeca)

            if comeu:
                pontos += 10
                comida = criar_maca(cobrinha, colunas, linhas)
            else:
                cobrinha.pop()

        # Centralizar mapa
        canvas.fill(FUNDO)

        mapa_x = (W - largura) // 2
        mapa_y = (H - altura) // 2

        desenhar_mapa(largura, altura)

        desenhar_maca(comida)
        desenhar_cobrinha(cobrinha, direcao)

        # Deslocar o mapa para o centro
        if mapa_x or mapa_y:
            recorte = canvas.subsurface(
                (0, 0, largura, altura)
            ).copy()

            canvas.fill(FUNDO)
            canvas.blit(recorte, (mapa_x, mapa_y))

        texto(
            f"PONTOS: {pontos}",
            fonte_pequena,
            BRANCO,
            100, 25
        )

        texto(
            f"SKIN: {equipada}",
            fonte_pequena,
            skins[equipada]["cor"],
            300, 25
        )

        apresentar()
        relogio.tick(60)

    if executando:

        animacao_morte(cobrinha)

        moedas += pontos
        salvar()

        game_over(pontos)


