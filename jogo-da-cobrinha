            500, 125
        )

        texto(
            "Escolha sua cobra!",
            fonte_pequena,
            BRANCO,
            500, 165
        )

        inicio = pagina * 6
        lista = nomes[inicio:inicio + 6]

        for i, nome in enumerate(lista):

            x = 100 + (i % 3) * 270
            y = 210 + (i // 3) * 175

            skin = skins[nome]
            cor = skin["cor"]
            tipo = skin["tipo"]

            ret = pygame.Rect(x, y, 230, 145)

            pygame.draw.rect(
                canvas,
                (25, 60, 45),
                ret,
                border_radius=15
            )

            pygame.draw.rect(
                canvas,
                cor,
                ret,
                3,
                border_radius=15
            )

            desenhar_cobra(
                canvas,
                x + 100,
                y + 55,
                cor,
                tipo
            )

            texto(
                nome.upper(),
                fonte_pequena,
                BRANCO,
                x + 115,
                y + 88
            )

            if nome in compradas:

                if nome == equipada:
                    legenda = "EQUIPADA"
                else:
                    legenda = "EQUIPAR"

                cor_botao = VERDE

            else:

                legenda = f"{skin['preco']} MOEDAS"
                cor_botao = LARANJA

            botao(
                legenda,
                x + 20,
                y + 105,
                190,
                30,
                mouse,
                cor_botao
            )

        voltar = botao(
            "VOLTAR",
            350, 590, 130, 50,
            mouse, VERMELHO
        )

        anterior = botao(
            "<",
            90, 590, 80, 50,
            mouse, VERDE
        )

        proximo = botao(
            ">",
            830, 590, 80, 50,
            mouse, VERDE
        )

        texto(
            f"Pagina {pagina + 1} / 2",
            fonte_pequena,
            BRANCO,
            500, 615
        )

        apresentar()

        for evento in pygame.event.get():

            if evento.type == pygame.QUIT:
                salvar()
                pygame.quit()
                sys.exit()

            if evento.type == pygame.KEYDOWN:
                if evento.key == pygame.K_F11:
                    alternar_tela()

            if evento.type == pygame.MOUSEBUTTONDOWN:

                if evento.button == 1:

                    mouse = pos_mouse(evento.pos)

                    if voltar.collidepoint(mouse):
                        return

                    if anterior.collidepoint(mouse):
                        pagina = 0

                    if proximo.collidepoint(mouse):
                        pagina = 1

                    for i, nome in enumerate(lista):

                        x = 100 + (i % 3) * 270
                        y = 210 + (i // 3) * 175

                        area = pygame.Rect(
                            x + 20, y + 105, 190, 30
                        )

                        if area.collidepoint(mouse):

                            skin = skins[nome]

                            if nome in compradas:
                                equipada = nome
                                salvar()

                            elif moedas >= skin["preco"]:

                                moedas -= skin["preco"]
                                compradas.append(nome)
                                equipada = nome

                                salvar()

        mouse = pos_mouse(pygame.mouse.get_pos())
        relogio.tick(60)


# ==========================================
# MAPA E MAÇÃ
# ==========================================

def criar_maca(cobrinha, colunas, linhas):

    espacos = [
        (x, y)
        for x in range(colunas)
        for y in range(linhas)
        if (x, y) not in cobrinha
    ]

    return random.choice(espacos) if espacos else None


def desenhar_mapa(largura, altura):

    canvas.fill(FUNDO)

    for x in range(0, largura, TAM):
        for y in range(0, altura, TAM):

            if (x // TAM + y // TAM) % 2 == 0:

                pygame.draw.rect(
                    canvas,
                    (20, 55, 38),
                    (x, y, TAM, TAM)
                )

    pygame.draw.rect(
        canvas,
        (90, 190, 105),
        (0, 0, largura, altura),
        4
    )


def desenhar_maca(pos):

    if pos is None:
        return

    x = pos[0] * TAM
    y = pos[1] * TAM

    pygame.draw.circle(
        canvas, (210, 25, 40), (x + 10, y + 12), 9
    )

    pygame.draw.circle(
        canvas, (255, 100, 100), (x + 7, y + 8), 3
    )

    pygame.draw.line(
        canvas, (100, 65, 30),
        (x + 10, y + 5),
        (x + 12, y + 1), 3
    )

    pygame.draw.ellipse(
        canvas, VERDE,
        (x + 11, y, 9, 5)
    )


# ==========================================
# DESENHAR COBRINHA NO JOGO
# ==========================================

def desenhar_cobrinha(cobrinha, direcao):

    skin = skins[equipada]
    cor = skin["cor"]
    tipo = skin["tipo"]

    for i, parte in enumerate(cobrinha):

        x = parte[0] * TAM
        y = parte[1] * TAM

        cor_parte = tuple(
            max(0, c - (i % 3) * 15) for c in cor
        )

        pygame.draw.rect(
            canvas,
            cor_parte,
            (x + 1, y + 1, TAM - 2, TAM - 2),
            border_radius=8
        )

        # Escamas do dragão
        if tipo == "dragao" and i > 0:
            pygame.draw.circle(
                canvas,
                (255, 150, 30),
                (x + 10, y + 10),
                3
            )

        # Brilhos do unicórnio
        if tipo == "unicornio" and i > 0:
            pygame.draw.circle(
                canvas,
                BRANCO,
                (x + 10, y + 10),
                3
            )

    # Olhos
    x = cobrinha[0][0] * TAM
    y = cobrinha[0][1] * TAM

    if direcao == (1, 0):
        olhos = [(x + 14, y + 5), (x + 14, y + 15)]
    elif direcao == (-1, 0):
        olhos = [(x + 5, y + 5), (x + 5, y + 15)]
    elif direcao == (0, -1):
        olhos = [(x + 5, y + 5), (x + 15, y + 5)]
    else:
        olhos = [(x + 5, y + 14), (x + 15, y + 14)]

    for olho in olhos:
        pygame.draw.circle(canvas, BRANCO, olho, 3)

    # Acessórios da cabeça
    centro = (x + 10, y + 10)

    if tipo == "dragao":

        pygame.draw.polygon(
            canvas, (255, 160, 20),
            [(x + 4, y + 3), (x - 2, y - 8), (x + 11, y + 2)]
        )

        pygame.draw.polygon(
            canvas, (255, 160, 20),
            [(x + 15, y + 3), (x + 22, y - 8), (x + 10, y + 2)]
        )

    elif tipo == "unicornio":

        pygame.draw.polygon(
            canvas, (255, 220, 70),
            [(x + 8, y + 3), (x + 10, y - 12), (x + 13, y + 3)]
        )


# ==========================================
# ANIMAÇÃO DE MORTE
# ==========================================

def animacao_morte(cobrinha):

    particulas = []

    for parte in cobrinha:

        x = parte[0] * TAM + TAM // 2
        y = parte[1] * TAM + TAM // 2

        for i in range(10):

            angulo = random.random() * math.pi * 2
            velocidade = random.uniform(2, 5)

            particulas.append([
                x, y,
                math.cos(angulo) * velocidade,
                math.sin(angulo) * velocidade,
                25
            ])

        for frame in range(12):

            desenhar_mapa(W, H)

            for p in particulas[:]:

                p[0] += p[2]
                p[1] += p[3]
                p[4] -= 1

                if p[4] <= 0:
                    particulas.remove(p)
                else:
                    pygame.draw.circle(
                        canvas,
                        skins[equipada]["cor"],
                        (int(p[0]), int(p[1])),
                        3
                    )

            apresentar()
            relogio.tick(45)


