# ==========================================
# SALVAR PROGRESSO
# ==========================================

ARQUIVO = "snake_save.json"

moedas = 0
compradas = ["Verde"]
equipada = "Verde"


def salvar():

    dados = {
        "moedas": moedas,
        "compradas": compradas,
        "equipada": equipada
    }

    with open(ARQUIVO, "w", encoding="utf-8") as arquivo:
        json.dump(dados, arquivo, indent=4)


def carregar():

    global moedas, compradas, equipada

    if os.path.exists(ARQUIVO):

        try:
            with open(ARQUIVO, "r", encoding="utf-8") as arquivo:
                dados = json.load(arquivo)

            moedas = max(0, int(dados.get("moedas", 0)))

            compradas = [
                nome for nome in dados.get("compradas", ["Verde"])
                if nome in skins
            ]

            if "Verde" not in compradas:
                compradas.append("Verde")

            nome = dados.get("equipada", "Verde")

            equipada = nome if nome in compradas else "Verde"

        except (ValueError, TypeError, json.JSONDecodeError):
            moedas = 0
            compradas = ["Verde"]
            equipada = "Verde"


carregar()

