        texto(
            "F11: alternar tela cheia",
            fonte_pequena,CINZA,700,640)

        # Cobra passeando no menu
        preview_cobra(tempo)

        texto(
            f"Equipado: {equipada}",
            fonte_pequena,
            skins[equipada]["cor"],
            500, 640
        )

        apresentar()

        for evento in pygame.event.get():

            if evento.type == pygame.QUIT:
                salvar()
                pygame.quit()
                sys.exit()

            if evento.type == pygame.KEYDOWN:

                if evento.key == pygame.K_F11:
                    alternar_tela()

            if evento.type == pygame.MOUSEBUTTONDOWN:

                if evento.button == 1:

                    mouse = pos_mouse(evento.pos)

                    if facil.collidepoint(mouse):
                        dificuldade = "FACIL"

                    elif medio.collidepoint(mouse):
                        dificuldade = "MEDIO"

                    elif dificil.collidepoint(mouse):
                        dificuldade = "DIFICIL"

                    elif loja_botao.collidepoint(mouse):
                        loja()

                    elif fullscreen_botao.collidepoint(mouse):
                        alternar_tela()

                    elif iniciar.collidepoint(mouse):
                        return

        tempo += 16
        relogio.tick(60)


# ==========================================
# EXECUÇÃO
# ==========================================

while True:

    menu()
    jogar()
