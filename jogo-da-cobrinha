    )

    pygame.draw.circle(
        superficie,
        (20, 20, 20),
        (x + 21, y + 5),
        2
    )

    # Chifres e asas do dragão
    if tipo == "dragao":

        pygame.draw.polygon(
            superficie,
            (255, 170, 30),
            [(x + 8, y - 10), (x, y - 25), (x + 16, y - 13)]
